{
  "name": "multiverse-match",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state --config wrangler.jsonc",
    "build": "node scripts/build-standalone.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config wrangler.jsonc",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
